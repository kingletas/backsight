# Copy to `.env` and change what you need. Every value has a default, so the
# suite runs from a clean checkout with no file here at all.

# The emulator build. **Pinned on purpose** — see docker-compose.yml.
MINISTACK_VERSION=1.5.8

# Not 4566: that's MiniStack's default port, so another emulator may already be
# there and it isn't ours to take. Change this if something else wants 14566.
MINISTACK_PORT=14566

# The engine the application invokes. `tofu` is the default and the only one
# built against; `terraform` is a binary you already have, if you have one.
BACKSIGHT_ENGINE=tofu

# 1 makes the emulator log every call it serves, which is what to turn on when
# a resource is created and the verification cannot find it.
MINISTACK_DEBUG=0
