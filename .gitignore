.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/

# The plan artifacts Backsight writes into a workspace. Runtime state that
# changes on every run — a binary that rewrites itself makes every working tree
# dirty for no reason. The rest of a `.backsight/` directory is written by a
# person (settings, stack definitions, the library), and in `fixtures/` it is
# part of the test, so it is tracked.
**/.backsight/*.tfplan
/.backsight/

# The user-level ~/.gitignore is core.excludesFile for every repository under
# $HOME and excludes *.sh outright. Without this negation the release workflow
# fails on a script that was never pushed.
!*.sh

# The same file excludes every directory named `sandbox/`, which is the name of
# a package here. Without this, four modules the application imports were
# never committed, and every clone was missing them.
!src/backsight/engine/sandbox/

# Disposable output: build products, screenshots, working images, scratch
# notes. Nothing here is reviewed and nothing here is committed.
#
# It carries its own line because the machine this was written on hides it
# through a user-level excludes file, and a clone has none of that.
local.d/

# The engine's provider cache, as CI names it. Hundreds of megabytes of binaries.
.plugin-cache/
